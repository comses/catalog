#!/usr/bin/env bash
# Deprecated: forwarding shim for scripts/compose.sh.
#
# Preserves the legacy invocation forms:
#   ./compose            # dev: base.yml + dev.yml
#   ./compose staging    # staging: base.yml + staging.yml
#   ./compose prod       # prod: base.yml + staging.yml + prod.yml
#
# Prefer `make compose-dev`; hosts render staging and production Compose files with `make prepare`.

set -o errexit
set -o nounset
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

echo "NOTE: ./compose is deprecated; use 'make compose-dev', or 'make prepare' on a host" >&2
exec bash "${script_dir}/scripts/compose.sh" "${1:-dev}"
